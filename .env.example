# Microsoft Azure AD App Registration
AZURE_TENANT_ID=your-tenant-id-here
AZURE_CLIENT_ID=your-client-id-here
AZURE_CLIENT_SECRET=your-client-secret-here

# OneDrive / SharePoint - Excel File
# The Drive ID where the Excel file is stored
ONEDRIVE_DRIVE_ID=your-drive-id-here
# The Item ID of the Excel workbook
ONEDRIVE_ITEM_ID=your-item-id-here
# The exact name of the simplified worksheet tab
WORKSHEET_NAME=Sheet1

# Optional: User UPN if using delegated access (leave blank for app-only)
ONEDRIVE_USER_UPN=

# App Config
NEXT_PUBLIC_APP_NAME=Field Sales Dashboard
NEXT_PUBLIC_REFRESH_INTERVAL=60000
